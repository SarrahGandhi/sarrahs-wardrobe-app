# Public client configuration only. Never add service-role or secret keys.
# Run npm run supabase:env after starting local Supabase to generate .env.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Android emulator alias for the host machine. Leave empty for hosted Supabase.
EXPO_PUBLIC_SUPABASE_ANDROID_URL=http://10.0.2.2:54321
