# Public client configuration only. Never add service-role or secret keys.
# Copy to .env and use your hosted project's URL and public publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Android emulator alias for the host machine. Leave empty for hosted Supabase.
EXPO_PUBLIC_SUPABASE_ANDROID_URL=
